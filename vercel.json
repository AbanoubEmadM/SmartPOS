{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "includeFiles": [
                "app/**",
                "bootstrap/**",
                "config/**",
                "database/**",
                "public/**",
                "resources/views/**",
                "routes/**",
                "vendor/**"
            ]
        }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/(css|js|images)/(.*)", "dest": "/public/$1/$2" },
        { "src": "/(.*)", "dest": "api/index.php" }
    ],
    "outputDirectory": "."
}
